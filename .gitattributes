# 统一换行符，避免 Windows / macOS 成员互相提交时产生整文件 diff
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.bat   text eol=crlf
*.ps1   text eol=crlf

# 二进制文件不参与换行符转换
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.exe   binary
